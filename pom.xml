<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      聚合 POM（阶段 2 · ADR-024）。
      只放 Spring Boot parent、坐标与模块列表；依赖和构建插件在各模块自己的 pom.xml 里。
      这样 common / domain 是普通 jar，只有 app / notification / timeout 才打可执行包。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.bluemalic</groupId>
    <artifactId>repair-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>repair-platform</name>
    <description>高校后勤报修 SaaS 平台（含 AI 数据助手）</description>

    <modules>
        <module>repair-app</module>
    </modules>
</project>
