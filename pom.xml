<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.bluemalic</groupId>
    <artifactId>repair-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>repair-platform</name>
    <description>高校后勤报修 SaaS 平台（含 AI 数据助手）</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <awssdk.version>2.29.12</awssdk.version>
        <sa-token.version>1.46.0</sa-token.version>
        <knife4j.version>4.5.0</knife4j.version>
        <!-- OpenAPI 描述生成器。Knife4j 的 starter 需配 2.3.0（Spring Boot 3.2 时代），
             而 Spring Boot 3.5 必须用 2.8.x —— 所以这里走「springdoc 生成 + Knife4j 静态 UI」。 -->
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <dependencies>
        <!-- ===== Web ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== 数据 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 数据库迁移 ===== -->
        <!-- 表结构由迁移脚本（src/main/resources/db/migration）管理，应用启动时自动执行。
             在这之前用的是 docs/schema.sql：它只在 MySQL 容器首次初始化时跑一次，库里有数据之后
             改表就只剩「手工进容器 ALTER」——没有版本、没有记录，换台机器要重来一遍。
             详见 docs/04 的 ADR-010。
             flyway-mysql 必须单独引：MySQL 支持从 flyway-core 里拆出来了，只引 core 会在
             启动时报 "Unsupported Database: MySQL"。
             两个版本都由 Spring Boot 统一管理，不写版本号。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ===== ORM ===== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MyBatis-Plus 从 3.5.9 起把 JSqlParser 拆成可选依赖。
             分页插件与数据权限拦截器都依赖它，不显式引入会在启动时报类找不到。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- ===== 鉴权 ===== -->
        <!--
            MinIO 用 S3 协议接入（ADR：不绑厂商）。选官方 AWS SDK 而不是 MinIO 自己的 SDK：
            换阿里云 OSS / 腾讯 COS 时只改 endpoint 与密钥，不动代码。
            只引 s3 这一个模块，不引整个 SDK 全家桶。
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- 登录态落 Redis，服务重启不掉线。用默认 opaque token 模式，不是 JWT，所以不需要密钥 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- BCrypt 密码加密。注意：这是从 Spring Security 项目拆出来的**纯加密工具包**
             （BCrypt / Argon2 / PBKDF2），不含过滤器链、没有自动装配，不违反 AGENTS 里
             「不要引入 Spring Security」那条约定；鉴权仍然走 Sa-Token。
             版本由 Spring Boot 统一管理，不写版本号。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ===== 接口文档 ===== -->
        <!-- 只引 Knife4j 的静态 UI（doc.html + webjars），不引它的 starter：
             starter 4.5.0 的 Java 代码是按 springdoc 2.3.0 编译的，与下面的 2.8.x 组合会在
             运行时抛 NoSuchMethodError（SpringDocConfigProperties.getGroupConfigs）。
             UI 包是纯静态资源、零 Java 类，不存在这个耦合；页面由 Spring Boot 自动提供。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-ui</artifactId>
            <version>${knife4j.version}</version>
        </dependency>
        <!-- OpenAPI 3 描述由 springdoc 生成，UI 从 /v3/api-docs/swagger-config 读取接口清单 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ===== 运维 ===== -->
        <!-- 部署脚本的健康检查与 nginx 都依赖 /actuator/health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== 工具 ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== 测试 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok 是编译期依赖，不打进可执行 jar -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
