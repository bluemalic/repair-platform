# ===== 拷贝到项目根目录后改名为 .env（.env 已在 .gitignore 里，不会进仓库）=====
# 仓库里只保留这份 example，真实密码和 Key 绝不提交

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=改成你自己的强密码
MYSQL_DATABASE=repair

# ---------- Redis ----------
REDIS_PASSWORD=改成你自己的强密码

# ---------- MinIO（图片存储）----------
MINIO_ROOT_USER=repair_minio
MINIO_ROOT_PASSWORD=改成你自己的强密码

# ---------- AI 模型（DeepSeek 官方 API）----------
# 申请地址：https://platform.deepseek.com  按量计费，跑评测集成本极低
AI_MODEL_API_KEY=sk-你的key
AI_MODEL_BASE_URL=https://api.deepseek.com
AI_MODEL_NAME=deepseek-chat

# ---------- 镜像（CI 构建用，本地可留空）----------
IMAGE_NAME=repair-app:latest
