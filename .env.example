# ===== 用法：复制本文件为 .env，再把下面的占位符改成你自己的真实值 =====
#        cp .env.example .env
#
# ⚠️ 本文件会提交到 Git 仓库，所以只能放占位符。
#    真实密码和 API Key 只放 .env —— .env 已被 .gitignore 忽略，不会进仓库。

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=改成你自己的密码
MYSQL_DATABASE=repair

# ---------- Redis ----------
REDIS_PASSWORD=改成你自己的密码

# ---------- MinIO（图片存储）----------
# ⚠️ MinIO 强制要求根密码至少 8 位，少于 8 位容器会反复重启
MINIO_ROOT_USER=repair_minio
MINIO_ROOT_PASSWORD=改成你自己的密码_至少8位

# ---------- 图片对外的地址（**服务器上必须改，否则图片上传成功但打不开**）----------
# 应用用它拼出返回给浏览器的图片 URL：{MINIO_PUBLIC_BASE_URL}/{bucket}/{对象键}。
# 它必须是**浏览器能访问到的**地址，不是应用连 MinIO 用的容器内网地址（那个是写死的 http://minio:9000）。
# 线上填 http://<服务器IP或域名>:<端口>/files —— nginx 把 /files/ 反代进容器网络（见 nginx/nginx.conf）。
# 本地开发保持默认值即可（MinIO 的 9000 在本机可直接访问）。
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
MINIO_BUCKET=repair

# ---------- Nginx 对外端口 ----------
# 本机 8080 常被 IDEA 里跑的应用占着，改这里不用动 compose 文件
NGINX_PORT=8080

# ---------- 内存上限（默认值是本地开发的宽松值）----------
# 下面这一组只在小内存机器（2C2G）上才需要改，改法见文件末尾的"小内存机型"。

# ---------- AI 模型（DeepSeek 官方 API）----------
# 申请地址：https://platform.deepseek.com  按量计费，跑评测集成本极低
AI_MODEL_API_KEY=sk-在这里填你自己的key
AI_MODEL_BASE_URL=https://api.deepseek.com
AI_MODEL_NAME=deepseek-chat

# ---------- AI 的只读数据库账号（**这是花钱功能的安全底座，别跳过**）----------
# 问数会执行大模型生成的 SQL，所以它连的账号**只授了白名单那几张表的 SELECT**：
# 改不了数据、删不了表、读不到别的表。账号由应用启动时自动创建（幂等），不用手工建。
# 两个变量要么都填、要么都不填：都留空 = 不启用 AI 问数（接口返回 40004），只填一个会启动报错。
# ⚠️ 口令会**每次启动同步**到这个账号上（它是应用自己要用的凭据，.env 是唯一真相来源）；
#    这与平台运营账号"只建不改"相反，别搞混。
#
#   AI_DB_USERNAME=repair_ai
#   AI_DB_PASSWORD=改成你自己的密码
#
# 查询阈值（ADR-003 第 4 层）：超时与行数上限，都有默认值，一般不用改
#   REPAIR_AI_QUERY_TIMEOUT_MS=3000
#   REPAIR_AI_MAX_ROWS=1000
# 问数接口的每分钟上限（**它是花钱的接口，这个值是成本上限**）。
# 公网演示站建议调到 3：演示账号的口令是公开的，谁都能登录问数
#   REPAIR_AI_RATE_LIMIT_MAX_REQUESTS=10

# ---------- 镜像（CI 构建用，本地可留空）----------
IMAGE_NAME=repair-app:latest

# ---------- Maven 镜像源（在国内构建镜像时必填）----------
# 不填会走 Maven Central，国内常出现 TLS 中断。**实测**：不填时 docker build 会失败在一行
# 看不出原因的报错上（"SSL peer shut down incorrectly" → PluginResolutionException），
# 填了之后同一份 Dockerfile 构建成功。
MAVEN_MIRROR=https://maven.aliyun.com/repository/public


# ============================================================
# 平台运营账号的引导（**可选**：不打算接第二所学校就不用填）
# ============================================================
# 平台运营账号用来开通 / 停用学校、维护每所学校的后勤管理员。它不属于任何租户
# （tenant_id = 0），所以**没有任何接口能创建它**——只能这样引导出来。
#
# 填了这两行 + 重启应用，账号就会被建出来（带「首次登录必须改密」）。之后：
#   · 登录时「学校编码」固定填 platform（管理端登录页有「平台运营登录」入口，不用手打）
#   · **只建不改**：账号已存在就什么都不做。忘记口令时删掉该账号再重启，而不是改这里的值
#     （改这里的值不会生效，且每次重启都打回旧口令会让「首登强制改密」白做）
#   · 两个变量**要么都填、要么都不填**；只填一个会启动报错——静默跳过的话现象是
#     "平台账号登不上"，要绕一圈才查到是配置没填全
#
#   REPAIR_PLATFORM_BOOTSTRAP_USERNAME=platform
#   REPAIR_PLATFORM_BOOTSTRAP_PASSWORD=改成你自己的口令
#   REPAIR_PLATFORM_BOOTSTRAP_REAL_NAME=平台管理员


# ============================================================
# 演示部署（**默认全关**，只在公网演示站打开）
# ============================================================
# 打开后：**应用启动时** + 每天凌晨（可配）各重置一次演示数据——
#   清空工单 / 流转日志 / 评价 / 通知 → 重建 5 个演示账号与 12 条示例工单 → 清空对象存储里的图片。
#   还会把演示口令改回下面这个值：访客在演示站上改过密码也能恢复（不然登录页写的口令会失效）。
# "重启应用 = 恢复演示数据"是这个模式的一部分：被玩坏了 `docker compose restart app` 即可。
#
# ⚠️ **生产部署不要打开**：它会删掉该租户的全部工单。只动 REPAIR_DEMO_TENANT_ID 指定的租户。
#
#   REPAIR_DEMO_ENABLED=true
#   REPAIR_DEMO_PASSWORD=演示口令（启用时必填，留空会启动报错）
#   REPAIR_DEMO_TENANT_ID=1
#   REPAIR_DEMO_RESET_CRON=0 0 4 * * *
#
# 配套的登录页提示是**构建时**注入的（前端没有运行时配置），构建前加一个环境变量：
#   VITE_DEMO_ACCOUNTS="演示账号：管理端 admin、维修工 worker01、学生 20260001，口令 xxx" npm run build
# 不注入就没有那一行——两种部署共用同一份代码。

# ============================================================
# 小内存机型（2 核 2G）—— 把下面这几行解开注释，覆盖上面的默认值
# ============================================================
# 不调会怎样：四个容器的上限加起来 2.2G，再加系统本身，MySQL 会被 OOM killer 杀掉，
# 而 `docker compose ps` 只会显示它"退出了"，看不出是内存不够。
#
# 另外**必须先加 swap**，否则内存尖峰（一次批量查询、一次镜像构建）就能把容器打死：
#   sudo fallocate -l 2G /swapfile && sudo chmod 600 /swapfile
#   sudo mkswap /swapfile && sudo swapon /swapfile
#   echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab   # 开机自动挂载
# 验完 `free -h` 看到 Swap 那行有 2.0Gi 即可。
#
# MYSQL_MEM_LIMIT=512M
# MYSQL_BUFFER_POOL=128M
# MYSQL_PERFORMANCE_SCHEMA=OFF     # 诊断用的库，能省 100-200MB
# REDIS_MEM_LIMIT=256M
# REDIS_MAXMEMORY=128mb
# MINIO_MEM_LIMIT=256M
# APP_MEM_LIMIT=512M
# JAVA_MAX_RAM_PERCENTAGE=55       # 512M × 55% ≈ 280M 堆，其余留给元空间与线程栈
