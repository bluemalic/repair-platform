<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluemalic</groupId>
        <artifactId>repair-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>repair-common</artifactId>
    <name>repair-common</name>
    <description>跨模块依赖库：统一返回体 / 错误码 / 业务异常 / 状态与动作枚举 / 限流 / 指标 / SQL AST 工具（不是服务）</description>

    <!--
      依赖面来自 common 包现在的真实 import（Result / GlobalExceptionHandler / TraceIdFilter /
      MetricsRecorder / RateLimiter / SqlAst），不是"以防万一"的预留：
      · spring-webmvc —— @RestControllerAdvice / ResponseEntity / NoHandlerFoundException 在这里，
        spring-context / spring-core 由它传递带入；
      · spring-data-redis —— RateLimiter 用 StringRedisTemplate + Lua 脚本做限流；
      · sa-token-core —— 全局异常处理器把 NotLogin / NotPermission / NotRole 转成业务错误码；
      · jsqlparser —— SqlAst 给数据权限拦截器与 AI 网关做 SQL 改写，5.2 与 mybatis-plus-jsqlparser
        传递引入的版本一致（见根 POM 注释）。
      将来 notification / timeout 只用得到这里的 Result / 枚举 / 工具，web 相关类不会被加载。
    -->
    <dependencies>
        <!-- 租户路由要读平台库的 tenant 表（TenantMapper/Tenant）并复用 MyBatis-Plus 生态，
             所以 common 依赖 domain；domain 不反向依赖 common，无环。 -->
        <dependency>
            <groupId>com.bluemalic</groupId>
            <artifactId>repair-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- TenantRoutingDataSource 继承 spring-jdbc 的 AbstractRoutingDataSource，
             Registry 直接建 Hikari 池，TenantDataSourceConfig 用 @ConfigurationProperties 绑
             spring.datasource.*——starter-jdbc 一次带齐 spring-jdbc / HikariCP / autoconfigure。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-core</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- 阶段 3.2：登录校验拦截器（SaInterceptor / SaRouter）随 SaTokenConfigure 一起下沉到 common，
             它不在 sa-token-core 里而在 Spring 适配包中。starter 的自动装配只对 SERVLET 应用生效，
             notification / timeout 是 WebApplicationType.NONE，不会因此起容器。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- PasswordEncoderConfig（BCrypt）被 identity 与单体共用。
             只是加密工具包，不含过滤器链 —— AGENTS §3 已明确允许。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- 数据权限拦截器（DataPermissionInterceptor）依赖 MP 的 JSqlParser 适配层，
             它从 3.5.9 起是独立坐标；common 里已有 jsqlparser 本体，但还缺这一层。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- TenantDatabaseProvisioner 用 Flyway API 跑租户库迁移（阶段 3.2 起它在 common）。
             只引 core：MySQL 方言由使用它的服务自己引 flyway-mysql（版本由 Boot 管理）。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>5.2</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
