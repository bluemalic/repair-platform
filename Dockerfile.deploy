# 部署用镜像：只装**预构建**的 jar，不编译。
#
# ⚠️ 这个文件是给 CD 用的，本地开发与手动构建用同目录下的 `Dockerfile`（那个是多阶段、
#    从源码编译）。**两者的"运行阶段"必须保持一致**——容器怎么跑（时区、非 root 用户、
#    JVM 参数）只由这里和 Dockerfile 的第二个阶段共同定义。改一处时同步改另一处。
#
# 为什么要分成两个文件（这是网络约束逼出来的，不是洁癖）：
#   服务器在腾讯云，构建所需的 `maven:3.9-eclipse-temurin-17` 基础镜像约 500MB，而它用的
#   Docker Hub 镜像站（docker.m.daocloud.io）拉大镜像时间歇性 502——实测连试两次都失败，
#   失败还会把已下载的层一起丢掉。而 CI 里那条 `mvn -B clean package` 本来就要跑
#   （测试 + 覆盖率门槛），jar 是现成的，传上去（约 60-80MB）比在服务器上重新编译更稳：
#     - 不依赖那个反复 502 的 maven 镜像
#     - 不在 2C2G 上跑 Maven（消掉与 MySQL 抢内存的 OOM 风险）
#     - 部署更快（组装镜像只要几秒，不是几分钟编译）
#
# 构建方式（在服务器上，上下文只有本文件与 app.jar，所以不会把 data/ 之类的塞进上下文）：
#   cd deploy && docker build -t repair-app:latest .
#
# ================= 与 Dockerfile 的运行阶段保持一致 =================
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 用非 root 用户运行（安全规范，面试可提）
RUN useradd -r -u 1001 appuser && chown -R appuser /app
USER appuser

# CD 传上来的 jar 与 Dockerfile 同名，所以两边的 COPY 目标一致
COPY app.jar app.jar

EXPOSE 8080

# 用 MaxRAMPercentage 而不是写死 -Xmx，容器内存上限变化时自动适配。
# 比例走环境变量：默认 70% 是本地/大内存机器的值，小内存机型（2C2G）要下调到 55% 左右——
# 堆只占 JVM 的一部分，元空间、线程栈、直接内存加起来能到 200MB 以上，
# 堆没满而容器先被 OOM killer 杀掉，是最难查的那种"莫名其妙重启"。
ENTRYPOINT ["sh", "-c", "java \
  -XX:+UseContainerSupport \
  -XX:MaxRAMPercentage=${JAVA_MAX_RAM_PERCENTAGE:-70} \
  -XX:+HeapDumpOnOutOfMemoryError \
  -XX:HeapDumpPath=/app/logs \
  -Duser.timezone=Asia/Shanghai \
  -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-prod} \
  -jar app.jar"]
# ================= 以上与 Dockerfile 的运行阶段必须一致 =================
