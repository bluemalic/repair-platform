# ============================================================
# 本地 full 专用覆盖：复制为 .env.full 后使用
#
#   cp .env.full.example .env.full
#   ./scripts/dev-full.sh
#
# 这个文件只放“完整版与 lite 不同的开关”；MySQL / Redis / MinIO / AI
# 的密码与 Key 仍放在 .env 里，两份一起被 app 的 env_file 读取。
#
# 注意：
# - 不要在 .env 里打开这些开关；否则 lite 部署会误走 MQ / 独立消费者。
# - 不要设置 REPAIR_TIMEOUT_SCHEDULER_ENABLED=false：
#   TimeoutScheduler 里同时有 ZSet 消费和 DB 兜底扫描，关掉会把兜底一起关掉。
# ============================================================

# 国内 Docker 构建必须换 Maven 镜像源，否则 dependency:go-offline 会卡在 Maven Central TLS 中断。
MAVEN_MIRROR=https://maven.aliyun.com/repository/public

# 事件通道：通知与超时都走 RocketMQ
REPAIR_ROCKETMQ_ENABLED=true
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
ROCKETMQ_CONSUMER_ENABLED=false

# 通知：由独立 notification-service 消费
REPAIR_NOTIFICATION_DELIVERY=mq

# 超时：由独立 timeout-service 消费；单体只做 DB 兜底扫描
REPAIR_TIMEOUT_DELIVERY=mq
REPAIR_TIMEOUT_CONSUMER_ENABLED=false
REPAIR_TIMEOUT_BACKSTOP_ENABLED=true
REPAIR_TIMEOUT_SCHEDULER_ENABLED=true

# 服务发现：Gateway 用 lb://repair-app 路由
NACOS_DISCOVERY_ENABLED=true
NACOS_SERVER_ADDR=nacos:8848
GATEWAY_APP_URI=lb://repair-app

# 本地 full 的内存上限（8G 以上机器可按需调大；4C4G 不要全开）
MYSQL_MEM_LIMIT=768M
REDIS_MEM_LIMIT=384M
MINIO_MEM_LIMIT=256M
APP_MEM_LIMIT=768M
ROCKETMQ_NAMESRV_MEM_LIMIT=384M
ROCKETMQ_BROKER_MEM_LIMIT=1G
ROCKETMQ_DASHBOARD_MEM_LIMIT=512M
NOTIFICATION_MEM_LIMIT=512M
TIMEOUT_MEM_LIMIT=384M
NACOS_MEM_LIMIT=512M
GATEWAY_MEM_LIMIT=384M
PROMETHEUS_MEM_LIMIT=384M
GRAFANA_MEM_LIMIT=256M
NODE_EXPORTER_MEM_LIMIT=64M
